{
  "name": "lens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn any codebase into an explorable knowledge graph with a security view.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev:dashboard": "pnpm --filter @lens/dashboard dev",
    "lens": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "@types/node": "^22.15.0"
  }
}
