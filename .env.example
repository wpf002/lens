# Optional. Only needed for `lens embed` (real embedding search).
# Pick one provider; leave the rest blank.
LENS_EMBED_PROVIDER=        # openai | voyage | ollama
OPENAI_API_KEY=
VOYAGE_API_KEY=
OLLAMA_HOST=http://localhost:11434
# Optional: the dashboard server port
LENS_PORT=4747
# Optional, hosted mode: authenticate as a GitHub App installation (no user sign-in to expire).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Only when the app is installed on more than one account
GITHUB_APP_INSTALLATION_ID=
